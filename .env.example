# Voorbeeldconfiguratie; geen echte credentials in Git opslaan.
# Productie gebruikt PostgreSQL-recordopslag v3; alle waarden zijn server-side.
# Zie docs/SERVER-OVERDRACHT.md voor runtime, driver en gecontroleerde migratie.

REMARKT_STORAGE_FORMAT=3
REMARKT_WORKSPACE_ID=
REMARKT_SESSION_SECRET=

# Effectieve URL: REMARKT_DATABASE_URL > DATABASE_URL > POSTGRES_URL.
# De huidige adapter gebruikt neon(url) / HTTP. Eigen PostgreSQL over TCP
# vereist eerst een geteste adapter; alleen deze URL wijzigen volstaat niet.
DATABASE_URL=
# REMARKT_DATABASE_URL=
# POSTGRES_URL=

# Alleen geaggregeerde timing/grootte/foutcodes, geen bodies of secrets.
# REMARKT_METRICS=1

# Onderhoud/back-up: beveiligde configuratie buiten Git.
# Directe, niet-gepoolde verbinding voor export/schemaonderhoud.
# REMARKT_DATABASE_URL_UNPOOLED=
# DATABASE_URL_UNPOOLED=
# REMARKT_BACKUP_DIR=
# REMARKT_BACKUP_MIRROR_DIR=
# REMARKT_BACKUP_KEY=
# REMARKT_ENV_FILE=

# Historische Redis-route; niet inrichten als vervanging voor actieve v3-data.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
